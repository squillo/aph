{
  "name": "aph",
  "version": "0.1.0-alpha.1",
  "edition": "2026",
  "description": "APH (Agent per Human) Protocol Specification: notarization envelope, mandates, and key discovery",
  "author": "APH Protocol Contributors",
  "authors": [],
  "license": "Apache-2.0",
  "tags": [],
  "framework": "n",
  "repository": "https://github.com/squillo/aph",
  "homepage": "https://squillo.com/nlang",
  "documentation": null,
  "keywords": [
    "aph",
    "notarization",
    "credentials",
    "agent",
    "did"
  ],
  "categories": [],
  "main": null,
  "target": null,
  "incremental": true,
  "features": {},
  "channel": null,
  "lens_gate": null,
  "src_dir": "../",
  "dep_dir": "./deps",
  "build_dir": "./build",
  "out_dir": "../../snapp",
  "wal_dir": "./.n/wal",
  "allowed_file_types": [
    "n.md",
    "n",
    "nbin",
    "json"
  ],
  "exclude": [
    ".n/*",
    ".nde/*",
    ".git/*",
    "node_modules/*"
  ],
  "export": [
    {
      "path": "ALL",
      "as_name": null
    }
  ],
  "start": [],
  "log_level": "info",
  "strict": false,
  "pretty": true,
  "indent": 2,
  "optimize_level": 0,
  "emit_snapp": true,
  "emit_deps": true,
  "emit_env": true,
  "emit_tests": true,
  "emit_blocks": true,
  "emit_meta_blocks": true,
  "emit_metadata": true,
  "emit_types": true,
  "emit_inferred": true,
  "emit_vars": false,
  "emit_derived": false,
  "emit_nodes": true,
  "emit_mod": true,
  "emit_links": false,
  "emit_dir_labels": false,
  "emit_temp_labels": false,
  "allow": [],
  "std_prelude": true,
  "language_prelude": true,
  "standard": true,
  "skip_linting": false,
  "lint_allow": [],
  "lint_deny": [],
  "lint_warn": [],
  "lib": null
}
