// A communication mandate for a service call.
//
// The same mandate shape covers machine traffic. The channel kind is
// service, the recipient is a URN naming the receiving service, and the body
// digest is over a structured payload rather than prose. Nothing about the
// notary's job changes because the reader is a program.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_channel_is_service() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:b3c4d5e6-f7a8-4b9c-8d0e-1f2a3b4c5d6e", delegation_mandate_id: "urn:uuid:0c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:dispatch-planner", channel_kind: "service", recipient_addressing: ["urn:service:example:dispatch-intake"], content_class: "New", body_sha256: "c19f6c4d5080c2222782af45f911577b6e51435f75cb00f0e5bad579fe19c2b1", body_size: 68, policy_decision: "AlwaysAllow", issued_at: "2026-10-02T23:40:00Z", expires_at: "2026-10-02T23:50:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.channel_kind, "service")
  }

  #[test]
  fn the_recipient_is_a_urn() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:b3c4d5e6-f7a8-4b9c-8d0e-1f2a3b4c5d6e", delegation_mandate_id: "urn:uuid:0c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:dispatch-planner", channel_kind: "service", recipient_addressing: ["urn:service:example:dispatch-intake"], content_class: "New", body_sha256: "c19f6c4d5080c2222782af45f911577b6e51435f75cb00f0e5bad579fe19c2b1", body_size: 68, policy_decision: "AlwaysAllow", issued_at: "2026-10-02T23:40:00Z", expires_at: "2026-10-02T23:50:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.recipient_addressing[0], "urn:service:example:dispatch-intake")
  }

  #[test]
  fn the_payload_is_bound_by_digest() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:b3c4d5e6-f7a8-4b9c-8d0e-1f2a3b4c5d6e", delegation_mandate_id: "urn:uuid:0c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:dispatch-planner", channel_kind: "service", recipient_addressing: ["urn:service:example:dispatch-intake"], content_class: "New", body_sha256: "c19f6c4d5080c2222782af45f911577b6e51435f75cb00f0e5bad579fe19c2b1", body_size: 68, policy_decision: "AlwaysAllow", issued_at: "2026-10-02T23:40:00Z", expires_at: "2026-10-02T23:50:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.body_sha256, "c19f6c4d5080c2222782af45f911577b6e51435f75cb00f0e5bad579fe19c2b1")
  }
}
