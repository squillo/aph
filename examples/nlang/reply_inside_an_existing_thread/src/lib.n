// A reply inside an existing thread.
//
// A reply is the lowest-risk class: the conversation already exists and the
// other party opened it. The communication mandate issued for it carries the
// same channel, recipient, class, digest and size as the envelope will, so
// the notary is signing one specific message, not permission to reply at will.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn a_reply_is_its_own_content_class() -> () {
    let c: CommunicationDescriptor = { content_class: "Reply", body_sha256: "634d5ba58851789daba59ff99e598f629c0908a6fb3f9c464d53fb0f64b7fca5", body_size: 81, preview_lines: 1, preview: "Yes, the 14:00 slot works. I will bring the signed lease and the deposit receipt." }
    assert_eq!(c.content_class, "Reply")
  }

  #[test]
  fn the_communication_mandate_repeats_the_digest() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:4f5a6b7c-8d9e-4f0a-9b1c-2d3e4f5a6b7c", delegation_mandate_id: "urn:uuid:7c1f3a9e-2b4d-4e6f-8a0b-1c2d3e4f5a6b", human_principal_did: "did:web:example.com:people:amira-haddad", agent_did: "did:web:example.com:agents:leasing", channel_kind: "email", recipient_addressing: ["tenant-412@example.net"], content_class: "Reply", body_sha256: "634d5ba58851789daba59ff99e598f629c0908a6fb3f9c464d53fb0f64b7fca5", body_size: 81, policy_decision: "AlwaysAllow", issued_at: "2026-02-11T09:30:00Z", expires_at: "2026-02-11T09:40:00Z", notary_signature: "z5mHtQ2vJx8kLw3nRb9cYp4sDf6gTa7uEi1oZq0WeXr2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2Fd" }
    assert_eq!(m.body_sha256, "634d5ba58851789daba59ff99e598f629c0908a6fb3f9c464d53fb0f64b7fca5")
  }

  #[test]
  fn the_mandate_lives_ten_minutes() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:4f5a6b7c-8d9e-4f0a-9b1c-2d3e4f5a6b7c", delegation_mandate_id: "urn:uuid:7c1f3a9e-2b4d-4e6f-8a0b-1c2d3e4f5a6b", human_principal_did: "did:web:example.com:people:amira-haddad", agent_did: "did:web:example.com:agents:leasing", channel_kind: "email", recipient_addressing: ["tenant-412@example.net"], content_class: "Reply", body_sha256: "634d5ba58851789daba59ff99e598f629c0908a6fb3f9c464d53fb0f64b7fca5", body_size: 81, policy_decision: "AlwaysAllow", issued_at: "2026-02-11T09:30:00Z", expires_at: "2026-02-11T09:40:00Z", notary_signature: "z5mHtQ2vJx8kLw3nRb9cYp4sDf6gTa7uEi1oZq0WeXr2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2Fd" }
    assert_eq!(m.expires_at, "2026-02-11T09:40:00Z")
  }
}
