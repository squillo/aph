// A delegation across three channels.
//
// An executive assistant agent for Jonah Whitfield may use Slack, email and
// Teams. The list is closed: a WhatsApp send under this mandate is refused
// with ChannelNotAllowed before any policy is consulted, because the
// delegation never reached that channel.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn three_channels_are_listed() -> () {
    let d: DelegationMandate = { id: "urn:uuid:2d4f6a8c-0e1b-4d3c-9a7b-5c6d7e8f9a0b", human_principal_did: "did:web:example.com:partners:jonah-whitfield", agent_did: "did:web:example.com:agents:project-coordinator", allowed_channels: ["slack", "email", "teams"], valid_from: "2026-01-15T00:00:00Z", valid_until: "2027-01-15T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.allowed_channels.len(), 3)
  }

  #[test]
  fn teams_is_the_third() -> () {
    let d: DelegationMandate = { id: "urn:uuid:2d4f6a8c-0e1b-4d3c-9a7b-5c6d7e8f9a0b", human_principal_did: "did:web:example.com:partners:jonah-whitfield", agent_did: "did:web:example.com:agents:project-coordinator", allowed_channels: ["slack", "email", "teams"], valid_from: "2026-01-15T00:00:00Z", valid_until: "2027-01-15T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.allowed_channels[2], "teams")
  }

  #[test]
  fn an_envelope_on_a_listed_channel_matches() -> () {
    let ch: ChannelDescriptor = { kind: "teams", recipient_addressing: ["19:a1b2c3d4e5f6@thread.v2"], recipient_class: "Human" }
    assert_eq!(ch.kind, "teams")
  }
}
