// A communication mandate for a bulk send.
//
// recipient_addressing is positional and may hold many entries. For a bulk
// send the mandate fixes every address up front, so the envelope cannot
// quietly add a fifth list after approval. The content class BulkSend tells
// the policy which rules applied.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn four_addresses_are_fixed() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:c4d5e6f7-a8b9-4c0d-9e1f-2a3b4c5d6e7f", delegation_mandate_id: "urn:uuid:3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a61", human_principal_did: "did:web:example.com:gna:ruth-abernathy", agent_did: "did:web:example.com:agents:newsletter", channel_kind: "email", recipient_addressing: ["list-a@example.com", "list-b@example.com", "list-c@example.com", "list-d@example.com"], content_class: "BulkSend", body_sha256: "a91349b0919212f28065a97772bfebd5dc3981e2b011fef18075a8cb16b74794", body_size: 82, policy_decision: "AskEveryTime", issued_at: "2026-11-01T14:00:00Z", expires_at: "2026-11-01T14:10:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.recipient_addressing.len(), 4)
  }

  #[test]
  fn the_fourth_is_list_d() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:c4d5e6f7-a8b9-4c0d-9e1f-2a3b4c5d6e7f", delegation_mandate_id: "urn:uuid:3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a61", human_principal_did: "did:web:example.com:gna:ruth-abernathy", agent_did: "did:web:example.com:agents:newsletter", channel_kind: "email", recipient_addressing: ["list-a@example.com", "list-b@example.com", "list-c@example.com", "list-d@example.com"], content_class: "BulkSend", body_sha256: "a91349b0919212f28065a97772bfebd5dc3981e2b011fef18075a8cb16b74794", body_size: 82, policy_decision: "AskEveryTime", issued_at: "2026-11-01T14:00:00Z", expires_at: "2026-11-01T14:10:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.recipient_addressing[3], "list-d@example.com")
  }

  #[test]
  fn the_class_is_bulk_send() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:c4d5e6f7-a8b9-4c0d-9e1f-2a3b4c5d6e7f", delegation_mandate_id: "urn:uuid:3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a61", human_principal_did: "did:web:example.com:gna:ruth-abernathy", agent_did: "did:web:example.com:agents:newsletter", channel_kind: "email", recipient_addressing: ["list-a@example.com", "list-b@example.com", "list-c@example.com", "list-d@example.com"], content_class: "BulkSend", body_sha256: "a91349b0919212f28065a97772bfebd5dc3981e2b011fef18075a8cb16b74794", body_size: 82, policy_decision: "AskEveryTime", issued_at: "2026-11-01T14:00:00Z", expires_at: "2026-11-01T14:10:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.content_class, "BulkSend")
  }
}
