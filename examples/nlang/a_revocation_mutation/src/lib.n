// Revoking a grant.
//
// Revoke withdraws authority. It carries no fields: the grant_scope_id on
// the mandate says what is being revoked. A revocation is itself notarized,
// so the record that authority ended is as verifiable as the record that it
// began.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_scope_being_revoked_is_named() -> () {
    let v: VaultMutationMandate = { kind: Revoke {}, grant_scope_id: "gs_site_assets" }
    assert_eq!(v.grant_scope_id, "gs_site_assets")
  }

  #[test]
  fn the_revocation_is_linked_to_an_envelope() -> () {
    let l: LinkedMandate = { vault_mutation: { kind: Revoke {}, grant_scope_id: "gs_site_assets" } }
    assert_eq!(l.vault_mutation.grant_scope_id, "gs_site_assets")
  }

  #[test]
  fn the_class_is_still_mutation() -> () {
    let c: CommunicationDescriptor = { content_class: "Mutation", body_sha256: "5308af545573a10686c8771ddfbfef9eeb3484705d38474f8a82db512a93c58e", body_size: 30, preview_lines: 1, preview: "op=revoke;grant=gs_site_assets" }
    assert_eq!(c.content_class, "Mutation")
  }
}
