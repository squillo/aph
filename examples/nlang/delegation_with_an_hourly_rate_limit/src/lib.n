// A delegation with a rate limit.
//
// A reminder agent for a dental practice may send on WhatsApp, at most
// thirty times an hour. The cap lives in the signed mandate. An agent that
// misbehaves cannot raise it, and the notary refuses the thirty-first send
// in the hour under the mandate's own terms.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn thirty_sends_an_hour_are_allowed() -> () {
    let d: DelegationMandate = { id: "urn:uuid:5e7a9c1b-3d2f-4a6e-8b0c-9d1e2f3a4b5c", human_principal_did: "did:web:example.org:practice:elena-marsh", agent_did: "did:web:example.org:agents:front-desk", allowed_channels: ["whatsapp"], allowed_recipient_classes: ["Human"], rate_limit_per_hour: 30, valid_from: "2026-07-01T00:00:00Z", valid_until: "2027-07-01T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.rate_limit_per_hour, 30)
  }

  #[test]
  fn the_limit_rides_with_the_channel_grant() -> () {
    let d: DelegationMandate = { id: "urn:uuid:5e7a9c1b-3d2f-4a6e-8b0c-9d1e2f3a4b5c", human_principal_did: "did:web:example.org:practice:elena-marsh", agent_did: "did:web:example.org:agents:front-desk", allowed_channels: ["whatsapp"], allowed_recipient_classes: ["Human"], rate_limit_per_hour: 30, valid_from: "2026-07-01T00:00:00Z", valid_until: "2027-07-01T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.allowed_channels[0], "whatsapp")
  }

  #[test]
  fn the_grant_runs_a_full_year() -> () {
    let d: DelegationMandate = { id: "urn:uuid:5e7a9c1b-3d2f-4a6e-8b0c-9d1e2f3a4b5c", human_principal_did: "did:web:example.org:practice:elena-marsh", agent_did: "did:web:example.org:agents:front-desk", allowed_channels: ["whatsapp"], allowed_recipient_classes: ["Human"], rate_limit_per_hour: 30, valid_from: "2026-07-01T00:00:00Z", valid_until: "2027-07-01T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.valid_until, "2027-07-01T00:00:00Z")
  }
}
