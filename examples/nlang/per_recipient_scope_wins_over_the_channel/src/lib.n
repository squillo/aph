// A per-recipient match.
//
// Jonah Whitfield's agent may DM colleagues freely on Teams, but a rule for
// one recipient, the firm's outside counsel, says ask first. The recipient
// rule is more specific and wins. matched_scope records that it did, so an
// auditor sees why this DM needed approval when others did not.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_recipient_rule_fired() -> () {
    let p: PolicyDescriptor = { decision: "AskEveryTime", matched_scope: "per-recipient", act_chain: ["human_present_request", "policy_evaluation", "human_approval", "notarize"] }
    assert_eq!(p.matched_scope, "per-recipient")
  }

  #[test]
  fn it_asked_where_the_channel_rule_would_not_have() -> () {
    let p: PolicyDescriptor = { decision: "AskEveryTime", matched_scope: "per-recipient", act_chain: ["human_present_request", "policy_evaluation", "human_approval", "notarize"] }
    assert_eq!(p.decision, "AskEveryTime")
  }

  #[test]
  fn the_recipient_is_outside_counsel() -> () {
    let a: Audience = { id: "did:web:example.net:counsel:r-fitzgerald" }
    assert_eq!(a.id, "did:web:example.net:counsel:r-fitzgerald")
  }
}
