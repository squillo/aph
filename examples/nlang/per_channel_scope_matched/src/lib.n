// A per-channel match.
//
// Policies are written at scopes. A per-channel rule says what this agent
// may do on Slack, whoever is on the other end. matched_scope tells a reader
// which kind of rule fired, which matters when a tighter per-recipient rule
// also exists and did not.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_channel_rule_fired() -> () {
    let p: PolicyDescriptor = { decision: "AlwaysAllow", matched_scope: "per-channel", delegation_mandate_id: "urn:uuid:93c6e1f0-5a2b-4c7d-8e9f-0a1b2c3d4e5f", act_chain: ["standing_mandate", "policy_evaluation", "notarize"] }
    assert_eq!(p.matched_scope, "per-channel")
  }

  #[test]
  fn the_channel_in_question() -> () {
    let ch: ChannelDescriptor = { kind: "discord", recipient_addressing: ["1098765432109876543"], recipient_class: "Human" }
    assert_eq!(ch.kind, "discord")
  }

  #[test]
  fn the_decision_under_that_rule() -> () {
    let p: PolicyDescriptor = { decision: "AlwaysAllow", matched_scope: "per-channel", delegation_mandate_id: "urn:uuid:93c6e1f0-5a2b-4c7d-8e9f-0a1b2c3d4e5f", act_chain: ["standing_mandate", "policy_evaluation", "notarize"] }
    assert_eq!(p.decision, "AlwaysAllow")
  }
}
