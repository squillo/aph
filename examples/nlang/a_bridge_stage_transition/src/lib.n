// A stage transition on a bridge.
//
// Bridged artifacts move through named stages, review to approved, say.
// BridgeStageTransition records both ends, so a verifier can see not only
// that a transition was authorized but that it was the right one: review to
// approved is a different act from approved to review.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn both_stages_are_named() -> () {
    let v: VaultMutationMandate = { kind: BridgeStageTransition { from_stage: "review", to_stage: "approved" }, grant_scope_id: "gs_release_bridge" }
    assert_eq!(v.grant_scope_id, "gs_release_bridge")
  }

  #[test]
  fn the_transition_is_linked() -> () {
    let l: LinkedMandate = { vault_mutation: { kind: BridgeStageTransition { from_stage: "review", to_stage: "approved" }, grant_scope_id: "gs_release_bridge" } }
    assert_eq!(l.vault_mutation.grant_scope_id, "gs_release_bridge")
  }

  #[test]
  fn the_request_body_says_the_same() -> () {
    let c: CommunicationDescriptor = { content_class: "Mutation", body_sha256: "6c165d86c77bd15b6ea5f9c92abe9d3ac4695f4eada29a52b9dd6359417995a7", body_size: 39, preview_lines: 1, preview: "op=bridge_stage;from=review;to=approved" }
    assert_eq!(c.preview, "op=bridge_stage;from=review;to=approved")
  }
}
