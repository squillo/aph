// From issued to delivered.
//
// The notary decides, then signs, then hands the envelope to the channel
// adapter. Three timestamps tell that story: decision_timestamp on the
// notarization metadata, created on the proof, and the adapter's own
// delivery record outside the envelope. They must not run backwards.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_decision_was_made_first() -> () {
    let n: NotarizationMetadata = { notary_service: { id: "did:web:notary.example.com", name: "Example Notary Service", version: "0.2.0" }, decision_timestamp: "2026-05-17T20:05:44Z", decision_latency_ms: 37 }
    assert_eq!(n.decision_timestamp, "2026-05-17T20:05:44Z")
  }

  #[test]
  fn the_proof_was_created_right_after() -> () {
    let p: EnvelopeProof = { type: "DataIntegrityProof", cryptosuite: "eddsa-jcs-2022", verification_method: "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV#z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV", created: "2026-05-17T20:05:45Z", proof_purpose: "assertionMethod", proof_value: "z3FXQjecWufY46yg5abdVZsXqLhxhueuSoZgNSARiKBk9czhSePTFehP8c3PGfb6a22gkfUKods5D2UAUL5n2Brbx" }
    assert_eq!(p.created, "2026-05-17T20:05:45Z")
  }

  #[test]
  fn delivery_is_the_last_state() -> () {
    let flow: Directional<str> = ["MandateIssued", "EnvelopeIssued", "Delivered"]
    assert_eq!(flow[2], "Delivered")
  }
}
