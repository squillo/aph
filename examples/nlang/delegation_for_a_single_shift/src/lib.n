// A delegation for one shift.
//
// A night-shift covering agent at a logistics desk gets authority from 22:00
// to 06:00 and not a minute more. Short windows are how a principal avoids
// revocation entirely: authority that expires on schedule needs no status
// list to withdraw it.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_window_opens_at_ten_pm() -> () {
    let d: DelegationMandate = { id: "urn:uuid:9b0c1d2e-3f4a-4b5c-8d6e-7f8a9b0c1d2e", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:night-cover", allowed_channels: ["slack", "service"], valid_from: "2026-10-01T22:00:00-05:00", valid_until: "2026-10-02T06:00:00-05:00", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.valid_from, "2026-10-01T22:00:00-05:00")
  }

  #[test]
  fn and_closes_at_six_am() -> () {
    let d: DelegationMandate = { id: "urn:uuid:9b0c1d2e-3f4a-4b5c-8d6e-7f8a9b0c1d2e", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:night-cover", allowed_channels: ["slack", "service"], valid_from: "2026-10-01T22:00:00-05:00", valid_until: "2026-10-02T06:00:00-05:00", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.valid_until, "2026-10-02T06:00:00-05:00")
  }

  #[test]
  fn the_cover_agent_is_not_the_day_agent() -> () {
    let d: DelegationMandate = { id: "urn:uuid:9b0c1d2e-3f4a-4b5c-8d6e-7f8a9b0c1d2e", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:night-cover", allowed_channels: ["slack", "service"], valid_from: "2026-10-01T22:00:00-05:00", valid_until: "2026-10-02T06:00:00-05:00", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.agent_did, "did:web:example.com:agents:night-cover")
  }
}
