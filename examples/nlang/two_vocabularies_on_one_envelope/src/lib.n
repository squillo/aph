// Two vocabularies at once.
//
// A firm can classify under the shared guardrails vocabulary and under its
// own house rules in the same envelope. Each is pinned separately with its
// own digest; a label is resolved against whichever vocabulary defines it.
// The house-rules digest here is over an illustrative artifact.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn two_vocabularies_are_pinned() -> () {
    let ac: ActClassification = { vocabularies: [{ name: "@com::squillo/aph_guardrails", version: "0.1.0", digest: "sha256-mhSlBjnzsw25+HiXcIJkijKokYkdf0CnUTj4xT0oWJc=" }, { name: "@com::example/house-rules", version: "1.2.0", digest: "sha256-MC08fz8hH5YxKtu58gvsvSqC4GETPvBzcg7J6/NrfNw=" }], labels: ["reply", "client-matter", "billable"] }
    assert_eq!(ac.vocabularies.len(), 2)
  }

  #[test]
  fn the_second_is_the_firm_s_own() -> () {
    let ac: ActClassification = { vocabularies: [{ name: "@com::squillo/aph_guardrails", version: "0.1.0", digest: "sha256-mhSlBjnzsw25+HiXcIJkijKokYkdf0CnUTj4xT0oWJc=" }, { name: "@com::example/house-rules", version: "1.2.0", digest: "sha256-MC08fz8hH5YxKtu58gvsvSqC4GETPvBzcg7J6/NrfNw=" }], labels: ["reply", "client-matter", "billable"] }
    assert_eq!(ac.vocabularies[1].version, "1.2.0")
  }

  #[test]
  fn each_carries_its_own_digest() -> () {
    let house: VocabularyRef = { name: "@com::example/house-rules", version: "1.2.0", digest: "sha256-MC08fz8hH5YxKtu58gvsvSqC4GETPvBzcg7J6/NrfNw=" }
    assert_eq!(house.digest, "sha256-MC08fz8hH5YxKtu58gvsvSqC4GETPvBzcg7J6/NrfNw=")
  }
}
