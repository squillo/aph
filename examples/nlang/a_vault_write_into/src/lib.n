// Writing into a vault.
//
// A vault mutation rides in linked_mandate.vault_mutation. WriteInto names
// the destination vault; grant_scope_id names the grant under which the
// write was allowed. The content class on the envelope is Mutation and the
// body is the mutation request itself.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_kind_names_the_destination() -> () {
    let v: VaultMutationMandate = { kind: WriteInto { dest_vault_id: "vault_7f3a" }, grant_scope_id: "gs_quarterly_close" }
    assert_eq!(v.grant_scope_id, "gs_quarterly_close")
  }

  #[test]
  fn it_rides_in_the_linked_mandate() -> () {
    let l: LinkedMandate = { vault_mutation: { kind: WriteInto { dest_vault_id: "vault_7f3a" }, grant_scope_id: "gs_quarterly_close" } }
    assert_eq!(l.vault_mutation.grant_scope_id, "gs_quarterly_close")
  }

  #[test]
  fn the_envelope_class_is_mutation() -> () {
    let c: CommunicationDescriptor = { content_class: "Mutation", body_sha256: "52071a5bad4ed777cb0a1004fa5c681fac809b83c06aa566179bc6af6b1103ce", body_size: 62, preview_lines: 1, preview: "op=write_into;dest_vault=vault_7f3a;artifact=close-2026q1.xlsx" }
    assert_eq!(c.content_class, "Mutation")
  }
}
