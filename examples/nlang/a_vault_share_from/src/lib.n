// Sharing from a vault.
//
// ShareFrom is the outbound counterpart of WriteInto: the agent was
// authorized to share something held in the source vault. The variant
// carries src_vault_id; the grant scope says under which standing
// permission.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_source_vault_is_named() -> () {
    let v: VaultMutationMandate = { kind: ShareFrom { src_vault_id: "vault_2c91" }, grant_scope_id: "gs_client_deliverables" }
    assert_eq!(v.grant_scope_id, "gs_client_deliverables")
  }

  #[test]
  fn the_mutation_is_linked_to_the_envelope() -> () {
    let l: LinkedMandate = { vault_mutation: { kind: ShareFrom { src_vault_id: "vault_2c91" }, grant_scope_id: "gs_client_deliverables" } }
    assert_eq!(l.vault_mutation.grant_scope_id, "gs_client_deliverables")
  }

  #[test]
  fn the_recipient_is_a_person_receiving_the_share() -> () {
    let a: Audience = { id: "did:web:example.net:clients:oakridge-llc" }
    assert_eq!(a.id, "did:web:example.net:clients:oakridge-llc")
  }
}
