// A signature that does not verify.
//
// The recipient canonicalizes the envelope, resolves the verification
// method, and checks the proof value. Here one byte of the body changed
// after signing, so the digest in the envelope no longer matches what was
// signed and the proof fails. Nothing else about the envelope is examined:
// a bad signature means the rest cannot be trusted either.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_proof_names_the_notary_s_key() -> () {
    let p: EnvelopeProof = { type: "DataIntegrityProof", cryptosuite: "eddsa-jcs-2022", verification_method: "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV#z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV", created: "2026-03-04T15:00:00Z", proof_purpose: "assertionMethod", proof_value: "z2Dsx9kQpJn7vRf4LwEt8cYbMa6gHu1oZi3SeXr5VbKmNj0LpOy2TgHs4FdAq6ZcXv8BnMk1Jl3Gh5FdSa7Qw" }
    assert_eq!(p.verification_method, "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV#z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV")
  }

  #[test]
  fn but_the_value_does_not_verify() -> () {
    let p: EnvelopeProof = { type: "DataIntegrityProof", cryptosuite: "eddsa-jcs-2022", verification_method: "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV#z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV", created: "2026-03-04T15:00:00Z", proof_purpose: "assertionMethod", proof_value: "z2Dsx9kQpJn7vRf4LwEt8cYbMa6gHu1oZi3SeXr5VbKmNj0LpOy2TgHs4FdAq6ZcXv8BnMk1Jl3Gh5FdSa7Qw" }
    assert_eq!(p.proof_value, "z2Dsx9kQpJn7vRf4LwEt8cYbMa6gHu1oZi3SeXr5VbKmNj0LpOy2TgHs4FdAq6ZcXv8BnMk1Jl3Gh5FdSa7Qw")
  }

  #[test]
  fn the_refusal_is_the_signature_error() -> () {
    let refusal: Directional<str> = ["InvalidEnvelopeSignature"]
    assert_eq!(refusal[0], "InvalidEnvelopeSignature")
  }
}
