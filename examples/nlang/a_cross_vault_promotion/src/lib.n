// Promoting an artifact across vaults.
//
// CrossVaultPromote moves an artifact from one trust boundary to another,
// for example from a drafts vault to a published one. The variant names the
// artifact, not the vaults: the grant scope already fixes which promotion
// path is allowed.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_artifact_is_named() -> () {
    let v: VaultMutationMandate = { kind: CrossVaultPromote { artifact_id: "art_5e2d9b" }, grant_scope_id: "gs_drafts_to_published" }
    assert_eq!(v.grant_scope_id, "gs_drafts_to_published")
  }

  #[test]
  fn the_scope_fixes_the_path() -> () {
    let l: LinkedMandate = { vault_mutation: { kind: CrossVaultPromote { artifact_id: "art_5e2d9b" }, grant_scope_id: "gs_drafts_to_published" } }
    assert_eq!(l.vault_mutation.grant_scope_id, "gs_drafts_to_published")
  }

  #[test]
  fn the_policy_asked_before_promoting() -> () {
    let p: PolicyDescriptor = { decision: "AskEveryTime", matched_scope: "per-channel", act_chain: ["human_present_request", "policy_evaluation", "human_approval", "notarize"] }
    assert_eq!(p.decision, "AskEveryTime")
  }
}
