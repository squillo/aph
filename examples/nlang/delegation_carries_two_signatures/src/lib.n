// Two signatures on a delegation.
//
// A delegation is the human's own act, so the human signs it, and the notary
// countersigns to record that it witnessed the grant. A communication
// mandate, by contrast, is issued by the notary alone under an existing
// delegation. The shape of each mandate type encodes who had to be present.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_principal_signed() -> () {
    let d: DelegationMandate = { id: "urn:uuid:c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f", human_principal_did: "did:key:z6MkfAkfRZ3v9zJWh9LM2YQbWLh6hqGYDVxxC7ueoVcd5dGy", agent_did: "did:key:z6MkiaMbhXHNA4eJVCCj8dbzKzTgYDKf6crKgHVHid1F1WCT", allowed_channels: ["email"], valid_from: "2026-01-01T00:00:00Z", valid_until: "2026-07-01T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.principal_signature, "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy")
  }

  #[test]
  fn and_so_did_the_notary() -> () {
    let d: DelegationMandate = { id: "urn:uuid:c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f", human_principal_did: "did:key:z6MkfAkfRZ3v9zJWh9LM2YQbWLh6hqGYDVxxC7ueoVcd5dGy", agent_did: "did:key:z6MkiaMbhXHNA4eJVCCj8dbzKzTgYDKf6crKgHVHid1F1WCT", allowed_channels: ["email"], valid_from: "2026-01-01T00:00:00Z", valid_until: "2026-07-01T00:00:00Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.notary_signature, "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk")
  }

  #[test]
  fn a_communication_mandate_has_only_the_notary_s() -> () {
    let m: CommunicationMandate = { id: "urn:uuid:d4e5f6a7-b8c9-4d0e-9f1a-2b3c4d5e6f7a", delegation_mandate_id: "urn:uuid:c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f", human_principal_did: "did:key:z6MkfAkfRZ3v9zJWh9LM2YQbWLh6hqGYDVxxC7ueoVcd5dGy", agent_did: "did:key:z6MkiaMbhXHNA4eJVCCj8dbzKzTgYDKf6crKgHVHid1F1WCT", channel_kind: "email", recipient_addressing: ["ops@example.com"], content_class: "Reply", body_sha256: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", body_size: 0, policy_decision: "AlwaysAllow", issued_at: "2026-02-01T12:00:00Z", expires_at: "2026-02-01T12:10:00Z", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(m.notary_signature, "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk")
  }
}
