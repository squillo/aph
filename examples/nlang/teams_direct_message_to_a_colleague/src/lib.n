// A Teams direct message to one colleague.
//
// Jonah Whitfield, a partner at an architecture practice, lets his project
// coordinator agent send scheduling notes directly to named colleagues. The
// mandate is scoped per recipient, so Dana Reyes is allowed where a stranger
// would not be. Note the content class: the wire vocabulary spells it DM.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn a_direct_message_names_one_thread() -> () {
    let e: NotarizationEnvelope = {
      aph_version: "0.1",
      context: ["https://www.w3.org/ns/credentials/v2"],
      type: ["VerifiableCredential", "AgentSendAuthorizationCredential"],
      id: "urn:uuid:c4d5e6f7-a8b9-4c0d-8e1f-2a3b4c5d6e7f",
      issuer: "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV",
      valid_from: "2026-06-02T08:45:03Z",
      valid_until: "2026-06-02T08:55:03Z",
      credential_subject: {
        human_principal: { id: "did:web:example.com:partners:jonah-whitfield", display_name: "Jonah Whitfield" },
        agent: { id: "did:web:example.com:agents:project-coordinator", display_name: "Project Coordinator", version: "2.0.1" },
        channel: { kind: "teams", recipient_addressing: ["19:a1b2c3d4e5f6@thread.v2"], recipient_class: "Human" },
        communication: { content_class: "DM", body_sha256: "7d62187d5a59cb7284b3e8517c6ed4eee5f1127d52042ea3148650df98a46a18", body_size: 103, preview_lines: 1, preview: "Dana, the structural review for the Birch Street site moved to Thursday at 10. The agenda is unchanged." },
        policy: { decision: "AlwaysAllow", matched_scope: "per-recipient", delegation_mandate_id: "urn:uuid:2d4f6a8c-0e1b-4d3c-9a7b-5c6d7e8f9a0b", act_chain: ["standing_mandate", "policy_evaluation", "notarize"] },
        notarization: { notary_service: { id: "did:web:notary.example.com", name: "Example Notary Service", version: "0.2.0" }, decision_timestamp: "2026-06-02T08:45:03Z", decision_latency_ms: 29 },
        audience: { id: "did:web:example.com:staff:dana-reyes" },
        act_classification: { vocabularies: [{ name: "@com::squillo/aph_guardrails", version: "0.1.0", digest: "sha256-mhSlBjnzsw25+HiXcIJkijKokYkdf0CnUTj4xT0oWJc=" }], labels: ["direct-message", "scheduling"] }
      },
      proof: { type: "DataIntegrityProof", cryptosuite: "eddsa-jcs-2022", verification_method: "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV#z6MkpTHR8VNsBxYAAWHut2Geadd9jSdoVTwBaPaeT1KhFmkV", created: "2026-06-02T08:45:03Z", proof_purpose: "assertionMethod", proof_value: "z3FXQjecWufY46yg5abdVZsXqLhxhueuSoZgNSARiKBk9czhSePTFehP8c3PGfb6a22gkfUKods5D2UAUL5n2Brbx" }
    }
    assert_eq!(e.credential_subject.channel.recipient_addressing.len(), 1)
  }

  #[test]
  fn the_content_class_is_spelled_dm_on_the_wire() -> () {
    let c: CommunicationDescriptor = { content_class: "DM", body_sha256: "7d62187d5a59cb7284b3e8517c6ed4eee5f1127d52042ea3148650df98a46a18", body_size: 103, preview_lines: 1, preview: "Dana, the structural review for the Birch Street site moved to Thursday at 10. The agenda is unchanged." }
    assert_eq!(c.content_class, "DM")
  }

  #[test]
  fn the_scope_that_matched_was_the_recipient() -> () {
    let p: PolicyDescriptor = { decision: "AlwaysAllow", matched_scope: "per-recipient", delegation_mandate_id: "urn:uuid:2d4f6a8c-0e1b-4d3c-9a7b-5c6d7e8f9a0b", act_chain: ["standing_mandate", "policy_evaluation", "notarize"] }
    assert_eq!(p.matched_scope, "per-recipient")
  }
}
