// A delegation for machine traffic only.
//
// Lee Nakamura's dispatch planner hands routes to other services. Its
// delegation allows the service channel and the Agent recipient class, and
// nothing else: it cannot be turned into a channel for messaging people by
// a prompt that asks nicely.

@deps {
  "@com::squillo/aph@0.1.0" {
    use { * },
    from: "../../../snapp/aph@0.1.0.nbin",
    integrity: "sha256-647ee58f80474f0d46a64e4cea4a447085cdf9a0e59d4a5d71f016137cf91245"
  }
}

mod * {
  #[test]
  fn the_channel_is_service() -> () {
    let d: DelegationMandate = { id: "urn:uuid:0c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:dispatch-planner", allowed_channels: ["service"], allowed_recipient_classes: ["Agent"], valid_from: "2026-01-01T00:00:00Z", valid_until: "2026-12-31T23:59:59Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.allowed_channels[0], "service")
  }

  #[test]
  fn the_recipient_class_is_agent() -> () {
    let d: DelegationMandate = { id: "urn:uuid:0c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f", human_principal_did: "did:web:example.com:dispatch:lee-nakamura", agent_did: "did:web:example.com:agents:dispatch-planner", allowed_channels: ["service"], allowed_recipient_classes: ["Agent"], valid_from: "2026-01-01T00:00:00Z", valid_until: "2026-12-31T23:59:59Z", principal_signature: "z2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy", notary_signature: "z4Jl6Gh2FdSa1QwErTy3UiOp5AsDfGh7JkLz9XcVbNm0QwErTy2VbNmKj8LpOy5TgHs3FdAq9ZcXv7BnMk" }
    assert_eq!(d.allowed_recipient_classes[0], "Agent")
  }

  #[test]
  fn the_receiving_service_is_named_by_urn() -> () {
    let ch: ChannelDescriptor = { kind: "service", recipient_addressing: ["urn:service:example:dispatch-intake"], recipient_class: "Agent" }
    assert_eq!(ch.recipient_addressing[0], "urn:service:example:dispatch-intake")
  }
}
