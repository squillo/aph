// APH NotarizationEnvelope — the W3C Verifiable Credential 2.0-shaped
// credential that carries a notarization (spec §7.1).
//
// Wire names are camelCase; N Lang props are snake_case, and the mapping is
// mechanical. Two wire keys cannot be written as identifiers at all and are
// noted where they appear: `@context` and `type`.
//
// Every prop below is part of the signed bytes. A verifier re-canonicalizes
// the envelope and checks the signature over the result, so adding,
// removing, or renaming anything here describes a DIFFERENT credential than
// the one deployed notaries issue.

mod blocks NotarizationEnvelope {
  props {
    // Wire: `aphVersion`. Pinned to "0.1"; verifiers reject other values.
    aph_version: str,
    // Wire: `@context`. JSON-LD contexts, always beginning with the W3C VC
    // 2.0 context followed by the APH context.
    context: Directional<str>,
    // Wire: `type`. MUST contain both "VerifiableCredential" and
    // "AgentSendAuthorizationCredential".
    type: Directional<str>,
    // `urn:uuid:` identifier for this envelope.
    id: str,
    // DID of the notary that issued and signed the credential.
    issuer: str,
    // RFC 3339 start of the validity window.
    valid_from: str,
    // RFC 3339 end of the validity window.
    valid_until: str,
    // The notarized claim.
    credential_subject: CredentialSubject,
    // Optional cross-protocol links (AP2 payment, vault mutation).
    #[optional(true)]
    linked_mandate: LinkedMandate,
    // The cryptographic proof block.
    proof: EnvelopeProof,
  }
}

// Who authorized what, on which channel, under which policy, attested by
// which notary (spec §7.1.2).
mod blocks CredentialSubject {
  props {
    human_principal: HumanPrincipalRef,
    agent: AgentRef,
    channel: ChannelDescriptor,
    communication: CommunicationDescriptor,
    policy: PolicyDescriptor,
    notarization: NotarizationMetadata,
    // Registered optional extension (spec §7.5.1).
    #[optional(true)]
    apple_aur_acceptance: AppleAurAcceptanceClaim,
  }
}

// The human on whose behalf the agent acted (spec §7.1.3).
mod blocks HumanPrincipalRef {
  props {
    // DID of the human principal.
    id: str,
    display_name: str,
  }
}

// The agent that produced the communication (spec §7.1.4).
mod blocks AgentRef {
  props {
    // DID of the agent, typically `did:web:`.
    id: str,
    // URI of the agent's A2A Agent Card, when it publishes one.
    #[optional(true)]
    agent_card_uri: str,
    display_name: str,
    version: str,
  }
}

// Delivery channel and its recipient addressing (spec §7.1.5).
mod blocks ChannelDescriptor {
  props {
    // One of the closed channel kinds: slack, email, discord, teams,
    // whatsapp, google_chat, imessage.
    kind: str,
    // Channel-shaped addressing. Deliberately opaque (spec §7.4) so a new
    // channel needs no change to this type; verifiers MUST NOT fail on
    // sub-fields they do not recognize.
    recipient_addressing: Positional,
  }
}

// What was sent, and the hash binding this credential to that exact body
// (spec §7.1.6).
mod blocks CommunicationDescriptor {
  props {
    // Reply, New, Mention, DM, Channel, BulkSend, or Broadcast.
    content_class: str,
    // SHA-256 of the body: 64 lowercase hex characters.
    body_sha256: str,
    body_size: u64,
    preview_lines: u32,
    // Truncated excerpt shown to the human at decision time.
    preview: str,
  }
}

// The authorization decision and the scope that produced it (spec §7.1.7).
mod blocks PolicyDescriptor {
  props {
    // AlwaysAllow, AskEveryTime, or NeverAllow.
    decision: str,
    // e.g. per-channel, per-recipient, global, per-content-class.
    matched_scope: str,
    // Parent delegation, absent for one-shot AskEveryTime grants.
    #[optional(true)]
    delegation_mandate_id: str,
    // RFC 8693 act chain of DID strings.
    act_chain: Directional<str>,
  }
}

// Which notary decided, when, and how long it took (spec §7.1.8).
mod blocks NotarizationMetadata {
  props {
    notary_service: NotaryServiceRef,
    // RFC 3339 decision timestamp.
    decision_timestamp: str,
    // Audit evidence for whether a human was plausibly in the loop.
    decision_latency_ms: u64,
  }
}

// Identity of the notary, used for key discovery (spec §7.1.9, §8.4).
mod blocks NotaryServiceRef {
  props {
    id: str,
    name: str,
    version: str,
  }
}

// Cross-protocol links carried alongside the send authorization
// (spec §7.1.10).
mod blocks LinkedMandate {
  props {
    // URI of an AP2 IntentMandate cross-linking payment authorization.
    #[optional(true)]
    ap2_intent_mandate_uri: str,
    // Registered optional extension (spec §7.5.2).
    #[optional(true)]
    ap2_signed_payload_b64: str,
    // Registered optional extension (spec §7.5.3).
    #[optional(true)]
    vault_mutation: VaultMutationMandate,
  }
}

// The signature block: a W3C Data Integrity Proof or a detached JWS
// (spec §7.1.11, §8.2).
mod blocks EnvelopeProof {
  props {
    // DataIntegrityProof or JsonWebSignature2020.
    type: str,
    // eddsa-jcs-2022 or ecdsa-jcs-2019. Absent for the JWS form.
    #[optional(true)]
    cryptosuite: str,
    // DID URL of the key, including its fragment.
    verification_method: str,
    // RFC 3339 proof creation timestamp.
    created: str,
    // Always "assertionMethod" for APH.
    proof_purpose: str,
    // Multibase base58btc signature over the canonical form with
    // proofValue emptied.
    proof_value: str,
  }
}

// Registered optional extension: Apple AUR acceptance (spec §7.5.1).
mod blocks AppleAurAcceptanceClaim {
  props {
    user_id: str,
    device_id: str,
    // SHA-256 hex of the accepted AUR snapshot text.
    aur_version_hash: str,
    // RFC 3339 acceptance timestamp.
    accepted_at: str,
    document_kind: str,
  }
}

// Registered optional extension: cross-vault mutation (spec §7.5.3).
//
// Interior keys are snake_case on the wire, unlike the camelCase envelope
// around them. That asymmetry is deliberate and pinned by the reference
// implementation, so it is reproduced faithfully here.
//
// The variants are internally tagged on the wire under the key `kind`. A
// type definition carries either props or enums, never both, so they live
// in their own container beside the mandate.
mod blocks VaultMutation {
  enum VaultMutationKind {
    WriteInto { dest_vault_id: str },
    ShareFrom { src_vault_id: str },
    CrossVaultPromote { artifact_id: str },
    Redelegate { downstream_grantee_id: str },
    Revoke,
    BridgeStageTransition { from_stage: str, to_stage: str },
    Custom { snapp_id: str, mutation_slug: str },
  }
}

mod blocks VaultMutationMandate {
  props {
    kind: $::*::VaultMutation::VaultMutationKind,
    grant_scope_id: str,
    #[optional(true)]
    ap2_signed_payload_b64: str,
  }
}
